@{
    ViewData["Title"] = "Add Project";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Add Project</h1>
        <p class="page-subtitle">Scanning: /Apps/Scrivener</p>
    </div>
</div>

<p><a asp-action="Dashboard">&larr; Back to Dashboard</a></p>

<div id="loadingState" style="text-align:center; padding:var(--space-10);">
    <p style="color:var(--color-ink-muted);">Loading projects from Dropbox&hellip;</p>
</div>

<div id="errorState" style="display:none;">
    <div class="card">
        <div class="card__body" style="text-align:center; padding:var(--space-10);">
            <p id="errorMessage" style="color:var(--color-ink-muted);"></p>
        </div>
    </div>
</div>

<div id="projectsContainer" style="display:none;">
    <form asp-action="AddProjects" method="post" id="addProjectsForm">
        @Html.AntiForgeryToken()

        <div style="display:grid; grid-template-columns:1fr auto 1fr; gap:var(--space-4); align-items:start; margin-bottom:var(--space-6);">

            <!-- Available list -->
            <div class="card">
                <div class="card__header">
                    <span class="card__title">Available</span>
                    <span id="availableCount" style="font-size:var(--text-sm); color:var(--color-ink-muted);">0 vault(s)</span>
                </div>
                <div id="availableList" style="min-height:120px; padding:var(--space-2);">
                    <p id="emptyAvailableMsg" style="color:var(--color-ink-muted); font-size:var(--text-sm); padding:var(--space-4); text-align:center; display:none;">
                        All projects already added
                    </p>
                </div>
            </div>

            <!-- Arrow buttons -->
            <div style="display:flex; flex-direction:column; gap:var(--space-2); padding-top:60px;">
                <button type="button" onclick="moveAllToSelected()"
                        class="btn btn--secondary btn--sm" title="Add all">&raquo;</button>
                <button type="button" onclick="moveAllToAvailable()"
                        class="btn btn--secondary btn--sm" title="Remove all">&laquo;</button>
            </div>

            <!-- Selected list -->
            <div class="card">
                <div class="card__header">
                    <span class="card__title">To Add</span>
                    <span id="selectedCount" style="font-size:var(--text-sm); color:var(--color-ink-muted);">0 selected</span>
                </div>
                <div id="selectedList" style="min-height:120px; padding:var(--space-2);">
                    <p id="emptySelectedMsg" style="color:var(--color-ink-muted); font-size:var(--text-sm); padding:var(--space-4); text-align:center;">
                        Click projects on the left to add them
                    </p>
                </div>
            </div>
        </div>

        <!-- Already added (populated by JS) -->
        <div id="alreadyAddedSection" style="display:none; margin-bottom:var(--space-6);">
            <div class="card">
                <div class="card__header">
                    <span class="card__title">Already Added</span>
                </div>
                <div id="alreadyAddedList" style="padding:var(--space-2);"></div>
            </div>
        </div>

        <!-- Hidden inputs populated by JS -->
        <div id="hiddenInputs"></div>

        <div style="display:flex; gap:var(--space-3); align-items:center;">
            <button type="submit" class="btn btn--primary" id="submitBtn" disabled>Add Selected</button>
            <a asp-action="Dashboard" class="btn btn--secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
    function esc(str) {
        return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function makeAvailableItem(p) {
        const el = document.createElement('div');
        el.className = 'project-item';
        el.dataset.uuid = p.syncRootId;
        el.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:var(--space-3) var(--space-4); border-radius:6px; margin-bottom:var(--space-2); background:var(--color-surface); border:1px solid var(--color-border); cursor:pointer;';
        el.innerHTML = `<div><div style="font-weight:500; font-size:var(--text-sm);">${esc(p.name)}</div><div style="font-size:0.75rem; color:var(--color-ink-muted);">${esc(p.vaultName)}</div></div><span style="color:var(--color-accent); font-size:1.1em;">&rsaquo;</span>`;
        el.onclick = function () { moveToSelected(el); };
        return el;
    }

    function moveToSelected(el) {
        el.onclick = null;
        el.querySelector('span').innerHTML = '&lsaquo;';
        el.querySelector('span').style.color = 'var(--color-danger)';
        el.onclick = function () { moveToAvailable(el); };
        document.getElementById('selectedList').appendChild(el);
        updateState();
    }

    function moveToAvailable(el) {
        el.onclick = null;
        el.querySelector('span').innerHTML = '&rsaquo;';
        el.querySelector('span').style.color = 'var(--color-accent)';
        el.onclick = function () { moveToSelected(el); };
        document.getElementById('availableList').appendChild(el);
        updateState();
    }

    function moveAllToSelected() {
        [...document.getElementById('availableList').querySelectorAll('.project-item')].forEach(el => moveToSelected(el));
    }

    function moveAllToAvailable() {
        [...document.getElementById('selectedList').querySelectorAll('.project-item')].forEach(el => moveToAvailable(el));
    }

    function updateState() {
        const selected  = document.getElementById('selectedList').querySelectorAll('.project-item');
        const available = document.getElementById('availableList').querySelectorAll('.project-item');

        document.getElementById('selectedCount').textContent  = selected.length + ' selected';
        document.getElementById('availableCount').textContent = available.length + ' vault(s)';
        document.getElementById('emptySelectedMsg').style.display  = selected.length  === 0 ? 'block' : 'none';
        document.getElementById('emptyAvailableMsg').style.display = available.length === 0 ? 'block' : 'none';
        document.getElementById('submitBtn').disabled = selected.length === 0;

        const container = document.getElementById('hiddenInputs');
        container.innerHTML = '';
        selected.forEach(el => {
            const input = document.createElement('input');
            input.type  = 'hidden';
            input.name  = 'selectedUuids';
            input.value = el.dataset.uuid;
            container.appendChild(input);
        });
    }

    async function loadProjects() {
        try {
            const response = await fetch('/Author/DiscoverProjects');
            if (!response.ok) throw new Error('HTTP ' + response.status);
            const projects = await response.json();

            const available = projects.filter(p => !p.alreadyAdded);
            const added     = projects.filter(p => p.alreadyAdded);

            const availableList = document.getElementById('availableList');
            available.forEach(p => availableList.appendChild(makeAvailableItem(p)));

            if (added.length > 0) {
                const addedList = document.getElementById('alreadyAddedList');
                added.forEach(p => {
                    const el = document.createElement('div');
                    el.style.cssText = 'display:flex; justify-content:space-between; align-items:center; padding:var(--space-3) var(--space-4); border-radius:6px; margin-bottom:var(--space-2); background:var(--color-surface); border:1px solid var(--color-border); opacity:0.6;';
                    el.innerHTML = `<div><div style="font-weight:500; font-size:var(--text-sm);">${esc(p.name)}</div><div style="font-size:0.75rem; color:var(--color-ink-muted);">${esc(p.vaultName)}</div></div><span style="color:var(--color-success); font-size:var(--text-sm);">&#10003; Added</span>`;
                    addedList.appendChild(el);
                });
                document.getElementById('alreadyAddedSection').style.display = 'block';
            }

            document.getElementById('loadingState').style.display   = 'none';
            document.getElementById('projectsContainer').style.display = 'block';
            updateState();

        } catch {
            document.getElementById('loadingState').style.display = 'none';
            document.getElementById('errorMessage').textContent   = 'Failed to load projects from Dropbox. Please try again.';
            document.getElementById('errorState').style.display   = 'block';
        }
    }

    loadProjects();
</script>
