@model InviteReaderViewModel
@{
    ViewData["Title"] = "Invite Reader";
}

<div class="page-header page-header--image">
    <div class="page-header__inner">
        <h1 class="page-header__title">Invite a Reader</h1>
        <p class="page-header__subtitle">An email will be sent with a link to create their account.</p>
    </div>
</div>

<div class="card invite-reader-card">
    <div class="card__body">
        <form asp-action="InviteReader" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="form-error"></div>

            <div class="form-group">
                <label asp-for="DisplayName">Reader display name</label>
                <input asp-for="DisplayName" type="text" />
                <span asp-validation-for="DisplayName" class="form-error"></span>
                <div class="form-hint">Shown on your readers list before the invitation is accepted.</div>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email address</label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="form-error"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="NeverExpires" id="neverExpires" />
                    Invitation never expires
                </label>
                <div class="form-hint">Untick to set an expiry date.</div>
            </div>

            <div class="form-group" id="expiryBlock">
                <label asp-for="ExpiresAt">Expiry date</label>
                <input asp-for="ExpiresAt" type="datetime-local" />
            </div>

            <div class="invite-reader-actions">
                <button type="submit" class="btn btn--primary">Send Invitation</button>
                <a asp-action="Readers" class="btn btn--secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        const checkbox = document.getElementById("neverExpires");
        const block = document.getElementById("expiryBlock");

        function update() {
            block.style.display = checkbox.checked ? "none" : "block";
        }

        checkbox.addEventListener("change", update);
        update();
    })();
</script>
