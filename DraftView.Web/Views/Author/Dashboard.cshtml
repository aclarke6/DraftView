@using DraftView.Domain.Enumerations
@using DraftView.Domain.Interfaces.Services
@using DraftView.Domain.Notifications
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    string FormatDashboardDate(DateTime? value) =>
        value.HasValue ? value.Value.ToString("dd MMM yyyy HH:mm") : "—";
}

<div class="page-header page-header--image">
    <div class="page-header__inner">
        <h1 class="page-header__title">Dashboard</h1>
        @if (Model.ActiveProject is not null)
        {
            <p class="page-header__subtitle">Active project: @Model.ActiveProject.Name</p>
        }
    </div>
</div>

<!-- Stat cards -->
<div class="stats-row">
    <div class="stat-card">
        <div class="stat-card__label">Active Readers</div>
        <div class="stat-card__value">@Model.ActiveReaderCount</div>
        <div class="stat-card__sub">
            <a asp-action="Readers">Manage readers</a>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Published Chapters</div>
        <div class="stat-card__value">@Model.PublishedChapterCount</div>
        <div class="stat-card__sub">
            @if (Model.ActiveProject is not null)
            {
                <a asp-action="Sections" asp-route-projectId="@Model.ActiveProject.Id">
                    View sections
                </a>
            }
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">Email Health</div>
        <div class="stat-card__value">
            @if (Model.EmailFailures.Count > 0)
            {
                <span class="dashboard-email-health__value dashboard-email-health__value--danger">@Model.EmailFailures.Count</span>
            }
            else
            {
                <span class="dashboard-email-health__value dashboard-email-health__value--success">OK</span>
            }
        </div>
        <div class="stat-card__sub">
            @if (Model.EmailFailures.Count > 0)
            {
                <span class="dashboard-email-health__sub dashboard-email-health__sub--danger">@Model.EmailFailures.Count failed</span>
            }
            else
            {
                <span>No failures</span>
            }
        </div>
    </div>
</div>

<!-- Two-column lower layout: main content left, notifications right -->
<div class="dashboard-body">

    <!-- â"€â"€ LEFT COLUMN â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€ -->
    <div class="dashboard-main">

        <!-- Projects -->
        <div class="card dashboard-table-card dashboard-table-card--spaced">
            <div class="card__header">
                <span class="card__title">Projects</span>
                <a asp-action="Projects" class="btn btn--secondary btn--sm desktop-only">+ Add Project</a>
            </div>
            <div class="table-wrapper table-wrapper--plain">
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th class="projects-table__col-name">Name</th>
                            <th class="projects-table__col-sync">Sync Status</th>
                            <th class="projects-table__col-reader-active">Reader Active</th>
                            <th class="projects-table__col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.AllProjects)
                        {
                            <tr>
                                <td class="projects-table__col-name">
                                    @if (p.ProjectType == ProjectType.Manual)
                                    {
                                        <a asp-action="ManualChapters" asp-route-projectId="@p.Id"
                                           class="dashboard-project-link">@p.Name</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Sections" asp-route-projectId="@p.Id"
                                           class="dashboard-project-link">@p.Name</a>
                                    }
                                </td>
                                <td class="projects-table__col-sync">
                                    @if (p.SyncStatus == SyncStatus.Healthy)
                                    {
                                        <span class="badge badge--success">Healthy</span>
                                    }
                                    else if (p.SyncStatus == SyncStatus.Error)
                                    {
                                        <span class="badge badge--danger" title="@p.SyncErrorMessage">Error</span>
                                        @if (!string.IsNullOrWhiteSpace(p.SyncErrorMessage))
                                        {
                                            <div class="projects-table__sync-error">@p.SyncErrorMessage</div>
                                        }
                                    }
                                    else if (p.SyncStatus == SyncStatus.Syncing)
                                    {
                                        <span class="badge badge--accent" id="sync-badge-@p.Id">Syncing...</span>
                                        <div id="sync-count-@p.Id" class="projects-table__sync-count">Starting...</div>
                                        <div class="projects-table__sync-progress">
                                            <div id="sync-bar-@p.Id" class="projects-table__sync-progress-bar"></div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge badge--neutral">@p.SyncStatus</span>
                                    }
                                </td>
                                <td class="projects-table__col-reader-active">
                                    @if (p.IsReaderActive)
                                    {
                                        <span class="badge badge--accent">Active</span>
                                    }
                                    else
                                    {
                                        <span class="dashboard-placeholder">-</span>
                                    }
                                </td>
                                <td class="dashboard-table__actions projects-table__col-actions">
                                    <div class="dashboard-table__actions-list">
                                        <form asp-action="Sync" method="post" class="dashboard-form-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@p.Id" />
                                            <button type="submit" class="btn btn--secondary btn--sm desktop-only"
                                                    @(p.SyncStatus == SyncStatus.Syncing ? "disabled" : "")>Sync</button>
                                        </form>
                                        <a asp-action="Publishing"
                                           asp-route-projectId="@p.Id"
                                           class="btn btn--secondary btn--sm desktop-only">Publishing</a>
                                        @if (!p.IsReaderActive)
                                        {
                                            <form asp-action="ActivateProject" method="post" class="dashboard-form-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="projectId" value="@p.Id" />
                                                <button type="submit" class="btn btn--primary btn--sm">Activate</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="DeactivateProject" method="post" class="dashboard-form-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="projectId" value="@p.Id" />
                                                <button type="submit" class="btn btn--secondary btn--sm">Deactivate</button>
                                            </form>
                                        }
                                        <form asp-action="RemoveProject" method="post" class="dashboard-form-inline"
                                              onsubmit="return confirm(@Html.Raw(Json.Serialize($"Remove {p.Name}? You can re-add it later.")))">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="projectId" value="@p.Id" />
                                            <button type="submit" class="btn btn--danger btn--sm desktop-only">Remove</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dashboard-table-card__mobile-note">
                Rotate to landscape to view additional project details.
            </div>
        </div>

        <!-- Published chapters -->
        @if (Model.PublishedChapterCount > 0)
        {
            <div class="card dashboard-table-card">
                <div class="card__header">
                    <span class="card__title">Reader Progress</span>
                    @if (Model.ActiveProject is not null)
                    {
                        <a asp-action="Sections" asp-route-projectId="@Model.ActiveProject.Id"
                           class="btn btn--ghost btn--sm">All sections</a>
                    }
                </div>
                <div class="dashboard-progress">
                    @if (Model.PublishedChapterProgress.UsesStructuralGroups)
                    {
                        <div class="dashboard-progress__list">
                            @foreach (var group in Model.PublishedChapterProgress.Groups)
                            {
                                <details class="dashboard-progress__group">
                                    <summary class="dashboard-progress__summary">
                                        <span class="dashboard-progress__summary-main">
                                            <span class="dashboard-progress__summary-title" role="heading" aria-level="3">@group.Title</span>
                                            <span class="dashboard-progress__summary-meta">
                                                @group.ViewedReaderChapterCount of @group.TotalReaderChapterCount reader views
                                            </span>
                                            <span class="dashboard-progress__summary-meta">@group.CommentCount comments</span>
                                            @if (group.NewCommentCount > 0)
                                            {
                                                <span class="badge badge--warning">@group.NewCommentCount new</span>
                                            }
                                            <span class="dashboard-progress__summary-meta">
                                                Latest activity: @FormatDashboardDate(group.LatestActivityAt)
                                            </span>
                                        </span>
                                    </summary>
                                    <div class="dashboard-progress__children">
                                        @foreach (var chapter in group.Chapters)
                                        {
                                            @await Html.PartialAsync("_DashboardChapterProgress", chapter)
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dashboard-progress__list">
                            @foreach (var chapter in Model.PublishedChapterProgress.Chapters)
                            {
                                @await Html.PartialAsync("_DashboardChapterProgress", chapter)
                            }
                        </div>
                    }
                </div>
                <div class="dashboard-table-card__mobile-note">
                    Expand acts, chapters, and readers without leaving the dashboard.
                </div>
            </div>
        }
        else if (Model.ActiveProject is not null)
        {
            <div class="card">
                <div class="card__body">
                    <div class="empty-state dashboard-empty-state">
                        <div class="empty-state__title">No chapters published yet</div>
                        <p class="empty-state__body dashboard-empty-state__body">
                            Sync your project and publish chapters to make them available to readers.
                        </p>
                        <a asp-action="Sections" asp-route-projectId="@Model.ActiveProject.Id"
                           class="btn btn--primary">Go to Sections</a>
                    </div>
                </div>
            </div>
        }

    </div><!-- /dashboard-main -->

    <!-- â"€â"€ RIGHT COLUMN: NOTIFICATIONS â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€â"€ -->
    <aside class="dashboard-sidebar">
        <div class="card notifications-panel">
            <div class="card__header">
                <span class="card__title">
                    Recent Activity
                    @if (Model.Notifications.Any())
                    {
                        <span class="badge badge--neutral dashboard-activity-count">
                            @Model.Notifications.Count
                        </span>
                    }
                </span>
                @if (Model.ActiveTypeFilter.HasValue)
                {
                    <a asp-action="Dashboard" class="btn btn--ghost btn--sm">Default</a>
                }
            </div>

            @{
                var allClass      = FilterChipClass(Model.ActiveTypeFilter, null);
                var commentClass  = FilterChipClass(Model.ActiveTypeFilter, NotificationFilterGroup.Comments);
                var replyClass    = FilterChipClass(Model.ActiveTypeFilter, NotificationFilterGroup.Replies);
                var readerClass   = FilterChipClass(Model.ActiveTypeFilter, NotificationFilterGroup.Readers);
                var syncClass     = FilterChipClass(Model.ActiveTypeFilter, NotificationFilterGroup.Sync);
            }
            <div class="notification-filters">
                <a asp-action="Dashboard" class="@allClass">Default</a>
                <a asp-action="Dashboard" asp-route-type="@NotificationFilterGroup.Comments" class="@commentClass">Comments</a>
                <a asp-action="Dashboard" asp-route-type="@NotificationFilterGroup.Replies"  class="@replyClass">Replies</a>
                <a asp-action="Dashboard" asp-route-type="@NotificationFilterGroup.Readers"  class="@readerClass">Readers</a>
                <a asp-action="Dashboard" asp-route-type="@NotificationFilterGroup.Sync"     class="@syncClass">Sync</a>
            </div>

            @if (!Model.Notifications.Any())
            {
                <div class="notifications-empty">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round"
                         class="notifications-empty__icon">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                    </svg>
                    <p class="notifications-empty__text">
                        No recent activity
                    </p>
                </div>
            }
            else
            {
                <ul class="notifications-list">
                    @foreach (var n in Model.Notifications)
                    {
                        <li class="notification-item">
                            @await Html.PartialAsync("_NotificationItem", n)
                            <form asp-action="DismissNotification" method="post" class="dashboard-form-contents">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="notificationId" value="@n.Id" />
                                <button type="submit" class="notification-item__dismiss" aria-label="Dismiss">&#x2715;</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>

</div><!-- /dashboard-body -->

@functions {
    static string FilterChipClass(NotificationFilterGroup? active, NotificationFilterGroup? chip) =>
        "notification-filter" + (active == chip ? " notification-filter--active" : "");
}

@if (Model.AllProjects.Any(p => p.SyncStatus == SyncStatus.Syncing))
{
    <style>
        @@keyframes syncpulse {
            0%   { width: 15%; }
            50%  { width: 85%; }
            100% { width: 15%; }
        }
    </style>
    <script>
        var syncingProjects = [@Html.Raw(string.Join(",", Model.AllProjects
            .Where(p => p.SyncStatus == SyncStatus.Syncing)
            .Select(p => $"\"{p.Id}\"")))];

        function pollSyncStatus() {
            syncingProjects.forEach(function(projectId) {
                fetch('/Author/GetSyncStatus?projectId=' + projectId)
                    .then(r => r.json())
                    .then(data => {
                        if (data.status !== 'Syncing') {
                            window.location.reload();
                        } else {
                            var countEl = document.getElementById('sync-count-' + projectId);
                            if (countEl) {
                                var barEl = document.getElementById('sync-bar-' + projectId);
                                if (data.filesDownloaded > 0 && data.sectionsProcessed === 0) {
                                    var total = data.totalFiles > 0 ? ' / ' + data.totalFiles : '';
                                    countEl.textContent = 'Downloading... ' + data.filesDownloaded + total + ' files';
                                    if (barEl && data.totalFiles > 0) { barEl.style.width = Math.round((data.filesDownloaded / data.totalFiles) * 100) + '%'; }
                                } else if (data.sectionsProcessed > 0) {
                                    countEl.textContent = data.filesDownloaded + ' files • ' + data.sectionsProcessed + ' sections processed';
                                    if (barEl) { barEl.style.width = '100%'; }
                                }
                            }
                        }
                    })
                    .catch(function() {});
            });

            if (syncingProjects.length > 0) {
                setTimeout(pollSyncStatus, 2000);
            }
        }

        setTimeout(pollSyncStatus, 2000);
    </script>
}




