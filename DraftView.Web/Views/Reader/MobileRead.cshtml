@model DraftView.Web.Models.MobileReadViewModel
@using DraftView.Domain.Enumerations
@{
    ViewData["Title"] = Model.Scene.Title;
}

@Html.AntiForgeryToken()

<div class="mobile-read"
     data-prose-font="@Model.ProseFont"
     data-prose-font-size="@Model.ProseFontSize">

    <nav class="mobile-read__nav">
        @if (Model.HasPrev)
        {
            <a asp-action="Read" asp-route-id="@Model.PrevSceneId"
               class="mobile-read__nav-btn">
                &#8592; Prev
            </a>
        }
        else
        {
            <span class="mobile-read__nav-btn mobile-read__nav-btn--disabled">&#8592; Prev</span>
        }

        <a asp-action="Scenes" asp-route-chapterId="@Model.Chapter.Id"
           class="mobile-read__nav-up">
            &#8593; Scenes@(Model.VersionLabel != null ? $" · {Model.VersionLabel}" : string.Empty)
        </a>

        @if (Model.HasNext)
        {
            <a asp-action="Read" asp-route-id="@Model.NextSceneId"
               class="mobile-read__nav-btn">
                Next &#8594;
            </a>
        }
        else
        {
            <span class="mobile-read__nav-btn mobile-read__nav-btn--disabled">Next &#8594;</span>
        }
    </nav>

    <div class="mobile-read__chapter">@Model.Chapter.Title</div>
    <h1 class="mobile-read__title">@Model.Scene.Title</h1>

    @if (Model.Chapter.IsLocked)
    {
        <div class="lock-notice">
            <p>The author is currently revising this chapter.</p>
        </div>
    }

    @if (Model.ShowUpdateBanner && Model.CurrentVersionNumber.HasValue)
    {
        <div class="update-banner" data-section-id="@Model.Scene.Id" data-version="@Model.CurrentVersionNumber">
            <div class="update-banner__content">
                <span class="update-banner__version">
                    @(Model.VersionLabel ?? $"Version {Model.CurrentVersionNumber}")
                </span>
            </div>
            <button type="button" class="update-banner__dismiss" aria-label="Dismiss update notice">
                Dismiss
            </button>
        </div>
    }

    @if (Model.UpdatedSinceLastRead)
    {
        <div class="scene-updated-notice">
            Updated since you last read
        </div>
    }

    <div class="mobile-read__prose"
         id="mobile-scene-@Model.Scene.Id"
         data-section-id="@Model.Scene.Id"
         data-section-version-id="@(Model.CurrentSectionVersionId?.ToString() ?? string.Empty)"
         data-resume-capture-text="@Model.ResumeCaptureText"
         data-resume-restore-has-target="@Model.HasResumeRestoreTarget.ToString().ToLowerInvariant()"
         data-resume-restore-start-offset="@(Model.ResumeRestoreStartOffset?.ToString() ?? string.Empty)"
         data-resume-restore-end-offset="@(Model.ResumeRestoreEndOffset?.ToString() ?? string.Empty)"
         data-resume-restore-status="@(Model.ResumeRestoreStatus?.ToString() ?? string.Empty)"
         data-resume-restore-confidence="@(Model.ResumeRestoreConfidenceScore?.ToString() ?? string.Empty)"
         data-resume-restore-match-method="@(Model.ResumeRestoreMatchMethod?.ToString() ?? string.Empty)">
        @if (Model.HasDiff)
        {
            @foreach (var para in Model.DiffParagraphs)
            {
                if (para.Type == DiffResultType.Added)
                {
                    <div class="diff-para diff-para--added">@Html.Raw(para.Html)</div>
                }
                else if (para.Type == DiffResultType.Removed)
                {
                    <div class="diff-para diff-para--removed"></div>
                }
                else
                {
                    @Html.Raw(para.Html)
                }
            }
        }
        else
        {
            @Html.Raw(Model.ResolvedHtmlContent ?? "<p><em>The author has not added content to this scene yet.</em></p>")
        }
    </div>

    <a asp-action="SceneComments" asp-route-sceneId="@Model.Scene.Id"
       class="mobile-scene-comments-link">
        @if (Model.SceneCommentCount > 0)
        {
            @:Scene Comments (@Model.SceneCommentCount) &#8250;
        }
        else
        {
            @:Scene Comments &#8250;
        }
    </a>

    <a asp-action="ChapterComments" asp-route-chapterId="@Model.Chapter.Id"
       class="mobile-scene-comments-link mobile-scene-comments-link--secondary">
        Chapter Comments &#8250;
    </a>

    <nav class="mobile-read__nav mobile-read__nav--bottom">
        @if (Model.HasPrev)
        {
            <a asp-action="Read" asp-route-id="@Model.PrevSceneId" class="mobile-read__nav-btn">&#8592; Prev</a>
        }
        else
        {
            <span class="mobile-read__nav-btn mobile-read__nav-btn--disabled">&#8592; Prev</span>
        }
        <a asp-action="Scenes" asp-route-chapterId="@Model.Chapter.Id" class="mobile-read__nav-up">&#8593; Scenes</a>
        @if (Model.HasNext)
        {
            <a asp-action="Read" asp-route-id="@Model.NextSceneId" class="mobile-read__nav-btn">Next &#8594;</a>
        }
        else
        {
            <span class="mobile-read__nav-btn mobile-read__nav-btn--disabled">Next &#8594;</span>
        }
    </nav>

</div>

<script>
    (function () {
        var antiForgeryInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!antiForgeryInput) {
            return;
        }

        document.querySelectorAll('.update-banner__dismiss').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var banner = btn.closest('.update-banner');
                if (!banner) {
                    return;
                }

                var sectionId = banner.dataset.sectionId;
                var version = banner.dataset.version;

                fetch('/Reader/DismissBanner', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryInput.value
                    },
                    body: 'sectionId=' + encodeURIComponent(sectionId) + '&versionNumber=' + encodeURIComponent(version)
                });

                banner.remove();
            });
        });
    })();

    (function () {
        function parseIntAttribute(element, name) {
            var value = element.getAttribute(name);
            if (!value) {
                return null;
            }

            var parsed = parseInt(value, 10);
            return Number.isNaN(parsed) ? null : parsed;
        }

        function buildCanonicalPoints(container) {
            var walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT);
            var points = [];
            var pendingWhitespace = null;

            while (walker.nextNode()) {
                var node = walker.currentNode;
                var text = node.nodeValue || '';

                for (var i = 0; i < text.length; i++) {
                    var character = text.charAt(i);
                    if (/\s/.test(character)) {
                        if (points.length > 0 && !pendingWhitespace) {
                            pendingWhitespace = { node: node, start: i, end: i + 1 };
                        }

                        continue;
                    }

                    if (pendingWhitespace) {
                        points.push(pendingWhitespace);
                        pendingWhitespace = null;
                    }

                    points.push({ node: node, start: i, end: i + 1 });
                }
            }

            return points;
        }

        function createCanonicalRange(container, startOffset, endOffset) {
            if (startOffset === null || endOffset === null || endOffset <= startOffset) {
                return null;
            }

            var points = buildCanonicalPoints(container);
            if (startOffset < 0 || endOffset > points.length) {
                return null;
            }

            var startPoint = points[startOffset];
            var endPoint = points[endOffset - 1];
            if (!startPoint || !endPoint) {
                return null;
            }

            var range = document.createRange();
            range.setStart(startPoint.node, startPoint.start);
            range.setEnd(endPoint.node, endPoint.end);
            return range;
        }

        var restoreProse = document.querySelector('.mobile-read__prose[data-resume-restore-has-target]');
        if (!window.location.hash &&
            restoreProse &&
            restoreProse.getAttribute('data-resume-restore-has-target') === 'true') {
            var restoreStart = parseIntAttribute(restoreProse, 'data-resume-restore-start-offset');
            var restoreEnd = parseIntAttribute(restoreProse, 'data-resume-restore-end-offset');
            var restoreRange = createCanonicalRange(restoreProse, restoreStart, restoreEnd);
            var restoreRect = restoreRange ? restoreRange.getBoundingClientRect() : restoreProse.getBoundingClientRect();
            var restoreY = window.scrollY + restoreRect.top - (window.innerHeight * 0.33);
            window.scrollTo(0, Math.max(0, Math.floor(restoreY)));
        }

        var antiForgeryInput = document.querySelector('input[name="__RequestVerificationToken"]');
        var prose = document.querySelector('.mobile-read__prose[data-section-id]');
        if (!antiForgeryInput || !prose) {
            return;
        }

        var captureUrl = '/Reader/CaptureResumePosition';
        var selectionLength = 48;
        var contextLength = 120;
        var lastCaptureKey = '';
        var timer;

        function normalizeText(text) {
            return (text || '').replace(/\s+/g, ' ').trim();
        }

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        async function hashText(text) {
            if (window.crypto && window.crypto.subtle && window.TextEncoder) {
                var bytes = new TextEncoder().encode(text);
                var digest = await window.crypto.subtle.digest('SHA-256', bytes);
                return Array.from(new Uint8Array(digest)).map(function (b) {
                    return b.toString(16).padStart(2, '0');
                }).join('');
            }

            return String(text.length) + ':' + text.substring(0, 32);
        }

        function trimSelectionBounds(text, start, end) {
            while (start < end && text.charAt(start) === ' ') {
                start++;
            }

            while (end > start && text.charAt(end - 1) === ' ') {
                end--;
            }

            return { start: start, end: end };
        }

        function buildPayload() {
            var canonicalText = prose.getAttribute('data-resume-capture-text') || '';
            var normalized = normalizeText(canonicalText);
            if (!normalized) {
                return null;
            }

            var rect = prose.getBoundingClientRect();
            var top = window.scrollY + rect.top;
            var focusY = window.scrollY + (window.innerHeight * 0.33);
            var ratio = clamp((focusY - top) / Math.max(prose.offsetHeight, 1), 0, 0.9999);
            var focusIndex = Math.floor(ratio * normalized.length);
            var start = Math.max(0, focusIndex - Math.floor(selectionLength / 2));
            var end = Math.min(normalized.length, start + selectionLength);
            var bounds = trimSelectionBounds(normalized, start, end);
            start = bounds.start;
            end = bounds.end;

            if (end <= start) {
                return null;
            }

            var selectedText = normalized.slice(start, end);
            if (!selectedText) {
                return null;
            }

            var prefixStart = Math.max(0, start - contextLength);
            var suffixEnd = Math.min(normalized.length, end + contextLength);

            return {
                sectionId: prose.getAttribute('data-section-id'),
                originalSectionVersionId: prose.getAttribute('data-section-version-id') || null,
                selectedText: selectedText,
                normalizedSelectedText: selectedText,
                prefixContext: normalized.slice(prefixStart, start),
                suffixContext: normalized.slice(end, suffixEnd),
                startOffset: start,
                endOffset: end,
                canonicalContentHash: '',
                selectedTextHash: '',
                htmlSelectorHint: '#mobile-scene-@Model.Scene.Id'
            };
        }

        async function capturePosition() {
            var payload = buildPayload();
            if (!payload || !payload.sectionId) {
                return;
            }

            var canonicalText = prose.getAttribute('data-resume-capture-text') || '';
            payload.selectedTextHash = await hashText(payload.normalizedSelectedText);
            payload.canonicalContentHash = await hashText(canonicalText);

            var captureKey = JSON.stringify([
                payload.sectionId,
                payload.originalSectionVersionId,
                payload.startOffset,
                payload.endOffset,
                payload.selectedText
            ]);
            if (captureKey === lastCaptureKey) {
                return;
            }

            lastCaptureKey = captureKey;

            fetch(captureUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': antiForgeryInput.value
                },
                body: JSON.stringify(payload)
            }).catch(function () {
                lastCaptureKey = '';
            });
        }

        window.addEventListener('scroll', function () {
            clearTimeout(timer);
            timer = setTimeout(capturePosition, 250);
        });

        window.addEventListener('beforeunload', capturePosition);
    })();
</script>
